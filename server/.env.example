PORT=3001

# ─── JWT Secrets ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 32 characters. Different values for access and refresh!
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_HERE_RUN_THE_COMMAND_ABOVE
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX_STRING_DIFFERENT_FROM_ABOVE

# ─── Encryption ─────────────────────────────────────────────
# 32-character secret for AES-256 token encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_HEX_STRING

# ─── AI Provider API Keys ────────────────────────────────────
# Groq: https://console.groq.com (Primary - FAST & FREE)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face: https://huggingface.co/settings/tokens (Fallback)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# ─── Cloudinary (File Storage) ───────────────────────────────
# Get from: https://console.cloudinary.com -> Settings -> API Keys
# IMPORTANT: Never put these values directly in code!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Telegram Bot ────────────────────────────────────────────
# Create a bot via @BotFather in Telegram
# Token format: 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Deployment ──────────────────────────────────────────────
# Your frontend URL (for share links and CORS)
FRONTEND_URL=https://teachflow-pi.vercel.app
# Your backend URL (for Telegram webhook registration)
SERVER_URL=https://your-backend.onrender.com

# ─── Database ────────────────────────────────────────────────
# Turso cloud database (optional, uses local SQLite if not set)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# ─── Google Sheets (Optional) ────────────────────────────────
# GOOGLE_SHEETS_CREDENTIALS_PATH=./config/google-credentials.json
